PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=apotek_pos
DB_DIALECT=mysql

# Kunci rahasia JWT minimal 32 karakter
# Buat string acak dengan perintah: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=6h

# Alamat aplikasi frontend lokal (Vite)
CLIENT_URL=http://localhost:5173
